# ------------------------------------------------------------------
# Tiny Treasure Competitions — Environment Template
# Copy this file to `.env` and fill in real values.
# ------------------------------------------------------------------

# Public site URL (no trailing slash). Used for canonicals, sitemap,
# JSON-LD and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Tiny Treasure Competitions"

# ---- Database (PostgreSQL) ----------------------------------------
# Local example:  postgresql://postgres:postgres@localhost:5432/tinytreasure
# Vercel/Neon/Supabase provide a pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tinytreasure?schema=public"
# Optional direct (non-pooled) connection used for migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tinytreasure?schema=public"

# ---- Auth ---------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ---- Stripe -------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the Stripe CLI (`stripe listen`) or the Dashboard webhook config.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---- Seed admin (used by prisma/seed.ts) --------------------------
SEED_ADMIN_EMAIL="admin@tinytreasure.co.uk"
SEED_ADMIN_PASSWORD="ChangeMe123!"
