# ------------------------------------------------------------------
# Tiny Treasure Competitions — PRODUCTION environment values
# Copy these into your Vercel project's Environment Variables (Production).
# Do NOT commit real secrets. This file is a template only.
# Primary domain: https://tinytreasurecompetitions.com (non-www)
# ------------------------------------------------------------------

# Public site URL — MUST be the non-www primary, no trailing slash.
# Drives canonicals, sitemap, JSON-LD and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL="https://tinytreasurecompetitions.com"
NEXT_PUBLIC_SITE_NAME="Tiny Treasure Competitions"

# ---- Database (PostgreSQL) ----------------------------------------
# On Vercel + Neon these are injected automatically when you connect the
# database (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct). You do not
# normally set these by hand — the Neon integration adds them.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ---- Auth ---------------------------------------------------------
# Generate a fresh value: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_A_FRESH_LONG_RANDOM_SECRET"

# ---- Stripe (LIVE) ------------------------------------------------
# Live keys make the "Test mode" banner disappear.
# In the Stripe Dashboard, enable the payment methods you want:
#   Cards, Apple Pay, Google Pay, and Pay by Bank (UK open banking).
STRIPE_SECRET_KEY="sk_live_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"
# From the Dashboard webhook endpoint https://tinytreasurecompetitions.com/api/webhooks/stripe
# subscribed to: checkout.session.completed, checkout.session.expired, charge.refunded
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---- Seed admin (only used if you run npm run db:seed) ------------
SEED_ADMIN_EMAIL="admin@tinytreasurecompetitions.com"
SEED_ADMIN_PASSWORD="CHANGE_THIS_STRONG_PASSWORD"
