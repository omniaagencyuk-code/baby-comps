// Tiny Treasure Competitions — Prisma schema
// Datasource: PostgreSQL. See .env.example for connection strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum CompetitionStatus {
  DRAFT
  PUBLISHED
  CLOSED
  DRAWN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EntryStatus {
  RESERVED
  CONFIRMED
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED
}

// ------------------------------------------------------------------
// Auth / users
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  phone         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  marketingOptIn Boolean  @default(false)
  stripeCustomerId String? @unique

  // Address (for invoices)
  addressLine1  String?
  addressLine2  String?
  city          String?
  postcode      String?
  country       String?  @default("United Kingdom")

  orders        Order[]
  entries       Entry[]
  wins          Winner[]
  savedComps    SavedCompetition[]
  auditLogs     AuditLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([role])
}

// ------------------------------------------------------------------
// Competition engine
// ------------------------------------------------------------------

model Competition {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  subtitle      String?
  description   String            @db.Text
  terms         String?           @db.Text

  // Media
  heroImage     String?
  images        String[]          @default([])

  // Pricing & value (money stored in pence / integer GBP)
  retailValue   Int               // pence
  ticketPrice   Int               // pence per entry
  maxEntries    Int
  entriesSold   Int               @default(0)
  maxPerUser    Int?              // optional cap per customer

  // Dates
  drawDate      DateTime
  closingDate   DateTime

  // Skill question (UK law compliance)
  skillQuestion String?
  answerOptions String[]          @default([])
  correctAnswer String?

  // Publishing & SEO
  status        CompetitionStatus @default(DRAFT)
  featured      Boolean           @default(false)
  archived      Boolean           @default(false)
  isTemplate    Boolean           @default(false)
  metaTitle     String?
  metaDescription String?

  categoryId    String?
  category      Category?         @relation(fields: [categoryId], references: [id])

  entries       Entry[]
  orderItems    OrderItem[]
  winner        Winner?
  savedBy       SavedCompetition[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([featured])
  @@index([closingDate])
  @@index([categoryId])
  @@index([archived])
  @@index([isTemplate])
}

model Entry {
  id            String      @id @default(cuid())
  ticketNumber  Int
  status        EntryStatus @default(CONFIRMED)

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())

  // A ticket number is unique within a competition.
  @@unique([competitionId, ticketNumber])
  @@index([userId])
  @@index([orderId])
}

// ------------------------------------------------------------------
// Orders & payments
// ------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  status         OrderStatus @default(PENDING)

  userId         String
  user           User        @relation(fields: [userId], references: [id])

  // Money in pence
  subtotal       Int
  discount       Int         @default(0)
  total          Int
  currency       String      @default("gbp")

  couponId       String?
  coupon         Coupon?     @relation(fields: [couponId], references: [id])

  stripeSessionId String?    @unique
  stripePaymentIntentId String?

  items          OrderItem[]
  entries        Entry[]
  payment        Payment?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id            String      @id @default(cuid())

  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  competitionTitle String   // snapshot at purchase time
  quantity      Int
  unitPrice     Int         // pence (snapshot — never trust the browser)
  lineTotal     Int         // pence

  createdAt     DateTime    @default(now())

  @@index([orderId])
  @@index([competitionId])
}

model Payment {
  id                    String        @id @default(cuid())

  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider              String        @default("stripe")
  status                PaymentStatus @default(PENDING)
  amount                Int           // pence
  currency              String        @default("gbp")

  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  receiptUrl            String?
  refundedAmount        Int           @default(0)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// ------------------------------------------------------------------
// Winners
// ------------------------------------------------------------------

model Winner {
  id            String      @id @default(cuid())

  competitionId String      @unique
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?       @relation(fields: [userId], references: [id])

  name          String      // display name (may differ from account)
  location      String?
  ticketNumber  Int?
  prizeTitle    String
  image         String?
  quote         String?     @db.Text
  published     Boolean     @default(false)
  drawnAt       DateTime    @default(now())

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([published])
}

// ------------------------------------------------------------------
// Content / CMS
// ------------------------------------------------------------------

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  competitions  Competition[]
  posts         BlogPost[]
  createdAt     DateTime      @default(now())
}

model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String    @db.Text
  coverImage    String?
  author        String    @default("Tiny Treasure Team")
  published     Boolean   @default(false)
  publishedAt   DateTime?

  metaTitle     String?
  metaDescription String?

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published])
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String  @db.Text
  category  String  @default("General")
  order     Int     @default(0)
  published Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([category])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType @default(PERCENT)
  value        Int        // percent (0-100) or pence for FIXED
  active       Boolean    @default(true)
  maxRedemptions Int?
  timesRedeemed Int       @default(0)
  minSpend     Int?       // pence
  expiresAt    DateTime?
  stripePromotionCodeId String?

  orders       Order[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String?
  alt       String?
  type      String   @default("image")
  folder    String   @default("general")
  width     Int?
  height    Int?
  bytes     Int?
  createdAt DateTime @default(now())

  @@index([folder])
}

// Customer reviews / testimonials shown on the homepage (CMS-managed).
model Review {
  id        String   @id @default(cuid())
  name      String
  location  String?
  quote     String   @db.Text
  rating    Int      @default(5)
  avatar    String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

// Structured, editable content blocks for homepage sections etc.
// `data` holds the block's JSON payload (shape depends on `key`).
model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  data      Json
  updatedAt DateTime @updatedAt
}

// CMS-managed content pages (about, terms, privacy, responsible play, guides…).
model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  published       Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([published])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model SavedCompetition {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, competitionId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("website")
  confirmed Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  meta      Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
}
